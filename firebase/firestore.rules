rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(patientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && get(/databases/$(database)/documents/patients/$(patientId)).data.ownerUid == request.auth.uid;
    }
    function isMember(patientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/patients/$(patientId)/members/$(request.auth.uid));
    }

    match /pairings/{linkCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && linkCode == request.auth.uid
        && request.resource.data.patientId == linkCode
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /patients/{patientId} {
      allow create: if signedIn()
        && patientId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isOwner(patientId) || isMember(patientId);
      allow update, delete: if isOwner(patientId);

      match /members/{memberUid} {
        allow read: if isMember(patientId);
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.pairingCode == patientId
          && exists(/databases/$(database)/documents/pairings/$(patientId))
          && get(/databases/$(database)/documents/pairings/$(patientId)).data.patientId == patientId;
        allow update: if signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.pairingCode == resource.data.pairingCode;
        allow delete: if isOwner(patientId);
      }

      match /{collection}/{documentId} {
        allow read, create, update: if isMember(patientId);
        allow delete: if isOwner(patientId);
      }
    }
  }
}