rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for user ownership or caretaker authenticated access
    function isAuth() { return request.auth != null; }

    match /patients/{uid}/passport/current {
      allow read: if isAuth();
      allow create, update: if isAuth()
        && request.resource.data.keys().hasOnly(['schemaVersion','name','age','region','isDemo','entries','revision'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.age is int
        && request.resource.data.region is string
        && request.resource.data.isDemo is bool
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 500
        && request.resource.data.revision is int;
      allow delete: if isAuth();
    }

    match /patients/{uid}/records/{id} {
      allow read, delete: if isAuth();
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['schemaVersion','id','kind','entryId','correct','responseMs','hintsUsed','difficulty','timestamp'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.id == id
        && request.resource.data.kind in ['familyRecognition','videoRecall','routineRecall','medicineRecall','episodicRecall']
        && request.resource.data.entryId is string
        && request.resource.data.correct is bool
        && request.resource.data.responseMs is int && request.resource.data.responseMs >= 0
        && request.resource.data.hintsUsed is int && request.resource.data.hintsUsed >= 0
        && request.resource.data.difficulty in [1,2,3]
        && request.resource.data.timestamp is string;
      allow update: if isAuth();
    }

    match /patients/{uid}/notes/{id} {
      allow read, write: if isAuth();
    }

    match /patients/{uid}/commands/{id} {
      allow read, write: if isAuth();
    }

    match /patients/{uid}/alerts/{id} {
      allow read, write: if isAuth();
    }
  }
}

